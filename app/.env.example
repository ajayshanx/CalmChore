# Public — safe to expose in the browser (protected by Row Level Security).
# These already have safe defaults baked into src/lib/supabase/config.ts, so
# the app works without setting them, but you can override here if needed.
NEXT_PUBLIC_SUPABASE_URL=https://wiexbxiywecrtqxjcjff.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, NEVER exposed to the browser or committed.
# Required for any server-side code acting on behalf of a child (children
# don't have Supabase Auth accounts, so RLS can't apply to them the normal
# way — server routes use this key and enforce authorization in app code).
# Get it from Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
